# Gunakan database/project Neon khusus AlebabaStore. Jangan gunakan connection
# string milik KasirKita atau Aletix agar seluruh data tetap terpisah.
DATABASE_URL_ALEBABASTORE=postgresql://USER:PASSWORD@HOST/alebabastore?sslmode=require

# Username aman untuk ditulis di konfigurasi. Password awal harus diberikan lewat
# secret manager platform deploy, bukan dimasukkan ke Git.
ADMIN_USERNAME=alebabastore
ADMIN_INITIAL_PASSWORD=
ADMIN_PASSWORD_RESET_VERSION=

# Buat dengan: openssl rand -hex 32
APP_ENCRYPTION_KEY=

# URL publik HTTPS aplikasi, dipakai untuk callback dan webhook TemanQRIS.
PUBLIC_BASE_URL=https://domain-alebabastore.example
PORT=8080
NODE_ENV=production
